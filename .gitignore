# typescript
*.tsbuildinfo
next-env.d.ts

# env files (never commit secrets)
# Catch-all with an explicit allow for the committed template: the previous list of exact names
# (.env, .env.local, .env.*.local) missed anything a file manager or editor renames on the way past,
# and ".env - Copy.local" — holding the live SERVICE ROLE key and JWT secret — sat untracked and
# UNIGNORED in the repo root, one `git add -A` from being published.
.env*
!.env.example
.dev.vars
.dev.vars.local
# backups of env / any file — never commit (may contain secrets)
*.bak
.env*.bak

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# os / editor
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json

# supabase local
/supabase/.branches
/supabase/.temp
.design-tmp/

# Local source-asset staging (curated copies live in public/)
Activity Pictures/

# Codex / MCP tool config (local, not project code)
.codex/

# graphify knowledge-graph output (generated tooling artifacts, not project code)
graphify-out/

# superpowers brainstorming scratch (throwaway HTML + a server PID, not project code)
.superpowers/

# Private browser source maps, extracted out of the deployable output by
# scripts/release/extract-source-maps.mjs so they are never served publicly.
sourcemaps-out/
